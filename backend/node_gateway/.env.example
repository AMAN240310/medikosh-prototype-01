PORT=5000
PYTHON_SERVICES_URL=http://localhost:8000
PYTHON_SCHEDULER_URL=http://localhost:8000

# JWT Authentication
# Change this to a long random secret in production!
JWT_SECRET=medikosh-dev-secret-change-in-production
JWT_EXPIRES_IN=12h

# CORS — comma-separated list of extra allowed origins (local dev origins always included)
ALLOWED_ORIGINS=

# Gemini API Keys (comma-separated or single)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Sarvam AI API Key for Hindi/Hinglish Voice STT/TTS
SARVAM_API_KEY=

# MongoDB Connection String (Clinical Records)
MONGODB_URI=mongodb://localhost:27017/medicare

# Supabase (PostgreSQL Appointments & Storage Bucket)
SUPABASE_URL=
SUPABASE_KEY=
